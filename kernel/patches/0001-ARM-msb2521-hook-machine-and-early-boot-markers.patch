From: Konrad Szelepusta
Subject: [PATCH] ARM: msb2521: hook machine directory and early boot markers

Register arch/arm/mach-msb2521 (GoClever Navio 505, MStar MSB2521 U03,
ARM926EJ-S) in the ARM Kconfig and Makefile.

Add single-character UART0 markers (A..F) to the early ARM entry path in
head.S/head-common.S. They are compiled only with CONFIG_ARCH_MSB2521 and
show how far the kernel got before any console exists:
A stext, B processor found, C ATAGs/DTB vetted, D phys/virt fixup done,
E page tables created, F about to call start_kernel (virtual UART).

Signed-off-by: Konrad Szelepusta
---
diff --git a/arch/arm/Kconfig b/arch/arm/Kconfig
--- a/arch/arm/Kconfig
+++ b/arch/arm/Kconfig
@@ -411,6 +411,8 @@
 
 source "arch/arm/mach-mstar/Kconfig"
 
+source "arch/arm/mach-msb2521/Kconfig"
+
 source "arch/arm/mach-mv78xx0/Kconfig"
 
 source "arch/arm/mach-mvebu/Kconfig"
diff --git a/arch/arm/kernel/head-common.S b/arch/arm/kernel/head-common.S
--- a/arch/arm/kernel/head-common.S
+++ b/arch/arm/kernel/head-common.S
@@ -118,6 +118,9 @@
 	bl	kasan_early_init
 #endif
 	mov	lr, #0
+#ifdef CONFIG_ARCH_MSB2521
+	navio_marker 70, 1
+#endif
 	b	start_kernel
 ENDPROC(__mmap_switched)
 
diff --git a/arch/arm/kernel/head.S b/arch/arm/kernel/head.S
--- a/arch/arm/kernel/head.S
+++ b/arch/arm/kernel/head.S
@@ -90,7 +90,33 @@
 	.arm
 
 	__HEAD
+
+#ifdef CONFIG_ARCH_MSB2521
+/* Diagnose the earliest ARM entry without depending on a registered console.
+ * The handoff supplies a private valid physical SP until head.S sets SP.
+ * After __mmap_switched the kernel stack and DEBUG_LL mapping are valid.
+ */
+.macro navio_marker, ch, virtual=0
+    stmdb sp!, {r0-r3, ip, lr}
+.if \virtual
+    ldr r3, =0xf0007600
+.else
+    ldr r3, =0xa0007600
+.endif
+    mov r0, #\ch
+1001:
+    ldrb r1, [r3, #0x28]
+    tst r1, #0x20
+    beq 1001b
+    strb r0, [r3]
+    ldmia sp!, {r0-r3, ip, lr}
+.endm
+
+#endif
 ENTRY(stext)
+#ifdef CONFIG_ARCH_MSB2521
+	navio_marker 65
+#endif
  ARM_BE8(setend	be )			@ ensure we are in BE8 mode
 
  THUMB(	badr	r9, 1f		)	@ Kernel is always entered in ARM.
@@ -109,6 +135,9 @@
 	movs	r10, r5				@ invalid processor (r5=0)?
  THUMB( it	eq )		@ force fixup-able long branch encoding
 	beq	__error_p			@ yes, error 'p'
+#ifdef CONFIG_ARCH_MSB2521
+	navio_marker 66
+#endif
 
 #ifdef CONFIG_ARM_LPAE
 	mrc	p15, 0, r3, c0, c1, 4		@ read ID_MMFR0
@@ -130,13 +159,22 @@
 	 * r8 = phys_offset, r9 = cpuid, r10 = procinfo
 	 */
 	bl	__vet_atags
+#ifdef CONFIG_ARCH_MSB2521
+	navio_marker 67
+#endif
 #ifdef CONFIG_SMP_ON_UP
 	bl	__fixup_smp
 #endif
 #ifdef CONFIG_ARM_PATCH_PHYS_VIRT
 	bl	__fixup_pv_table
+#ifdef CONFIG_ARCH_MSB2521
+	navio_marker 68
+#endif
 #endif
 	bl	__create_page_tables
+#ifdef CONFIG_ARCH_MSB2521
+	navio_marker 69
+#endif
 
 	/*
 	 * The following calls CPU specific code in a position independent
diff --git a/arch/arm/Makefile b/arch/arm/Makefile
--- a/arch/arm/Makefile
+++ b/arch/arm/Makefile
@@ -202,6 +202,7 @@
 machine-$(CONFIG_ARCH_MILBEAUT)		+= milbeaut
 machine-$(CONFIG_ARCH_MXS)		+= mxs
 machine-$(CONFIG_ARCH_MSTARV7)		+= mstar
+machine-$(CONFIG_ARCH_MSB2521)		+= msb2521
 machine-$(CONFIG_ARCH_NOMADIK)		+= nomadik
 machine-$(CONFIG_ARCH_NPCM)		+= npcm
 machine-$(CONFIG_ARCH_OMAP1)		+= omap1
-- 
2.43.0
